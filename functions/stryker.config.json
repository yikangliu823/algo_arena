{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test test/*.test.mjs"
  },
  "mutate": [
    "coach-core.js",
    "deps.js"
  ],
  "reporters": [
    "html",
    "clear-text",
    "progress",
    "json"
  ],
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": 70
  },
  "coverageAnalysis": "off"
}